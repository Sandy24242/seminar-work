# Copy values into your shell (PowerShell: $env:NAME="value"). No secrets are needed.
# Folder containing the 5 trained .keras files + 5 *_metadata.json files. Default: backend/models
DCAI_MODELS_DIR=
# Comma-separated origins allowed to call the API (the Vite dev server by default)
DCAI_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DCAI_LOG_LEVEL=INFO
# Optional regex of extra allowed origins, e.g. Vercel preview deployments: https://.*\.vercel\.app
DCAI_CORS_ORIGIN_REGEX=
